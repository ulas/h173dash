#!/bin/sh /etc/rc.common
# h173d - H173-386 5G CPE poller / ubus provider

START=95
STOP=10
USE_PROCD=1
PROG=/usr/sbin/h173d

start_service() {
	config_load h173
	local enabled
	config_get_bool enabled main enabled 1
	[ "$enabled" = "1" ] || return 0

	procd_open_instance
	procd_set_param command /usr/bin/ucode -S "$PROG"
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "h173"
}

reload_service() {
	stop
	start
}
